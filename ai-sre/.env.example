# Copy to ai-sre/.env (gitignored). scripts/up.sh turns it into a Kubernetes Secret
# that both the ai-sre and aura containers read. Values never go into a ConfigMap.

# Nebius Token Factory (OpenAI-compatible). AURA's [agent.llm] uses these.
NEBIUS_API_KEY=replace-me
AI_SRE_MODEL=moonshotai/Kimi-K3.1-Pro

# GitHub MCP (remote server at api.githubcopilot.com/mcp/), and Argo CD's read access to this repo.
# Use a FINE-GRAINED PAT scoped to this ONE repo with only:
#   Contents: read & write   Pull requests: read & write   Metadata: read
# No admin, no workflows, no actions. Branch protection on main requires a PR.
GITHUB_TOKEN=github_pat_replace-me
GITHUB_REPO=shivaylamba/self-healing-canaries

# true = diagnose only: the HITL policy webhook denies every GitHub write
AI_SRE_DRY_RUN=false
