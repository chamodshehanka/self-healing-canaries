# Copy to ai-sre/.env (gitignored). scripts/up.sh turns it into a Kubernetes Secret.

# OpenAI Agents SDK
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.5

# GitHub MCP (remote server at api.githubcopilot.com/mcp/).
# Use a FINE-GRAINED PAT scoped to this ONE repo with only:
#   Contents: read & write   Pull requests: read & write   Metadata: read
# No admin, no workflows, no actions. Branch protection on main requires a human review.
GITHUB_TOKEN=github_pat_replace-me
GITHUB_REPO=chamodshehanka/self-healing-canaries

# true = diagnose only, GitHub write tools are filtered out
AI_SRE_DRY_RUN=false
