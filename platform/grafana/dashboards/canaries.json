{
  "uid": "self-healing-canaries",
  "title": "Self-Healing Canaries",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "argocon"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "STAGING",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate per ReplicaSet (what the gate sees)",
      "description": "Scoped to each pod-template-hash. 1% line = the gate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-staging"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rollouts_pod_template_hash) (rate(http_server_duration_milliseconds_count{app=\"payment\",http_status_code=~\"5..\"}[1m])) / sum by (rollouts_pod_template_hash) (rate(http_server_duration_milliseconds_count{app=\"payment\"}[1m]))",
          "legendFormat": "hash {{rollouts_pod_template_hash}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-staging"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Service-wide error rate (what an SLO alert sees)",
      "description": "Diluted: a 1% canary failing 30% of requests moves this by 0.3%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-staging"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{app=\"payment\",http_status_code=~\"5..\"}[1m])) / sum(rate(http_server_duration_milliseconds_count{app=\"payment\"}[1m]))",
          "legendFormat": "payment (all pods)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-staging"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency per ReplicaSet (what a latency check sees)",
      "description": "Gray failures fail fast. The broken canary is often FASTER.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-staging"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, rollouts_pod_template_hash) (rate(http_server_duration_milliseconds_bucket{app=\"payment\"}[2m])))",
          "legendFormat": "hash {{rollouts_pod_template_hash}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-staging"
          }
        }
      ]
    },
