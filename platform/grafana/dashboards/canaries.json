          "legendFormat": "hash {{rollouts_pod_template_hash}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-staging"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "payment errors (OTel logs \u2192 Loki, hash added by the collector)",
      "datasource": {
        "type": "loki",
        "uid": "loki-staging"
      },
      "gridPos": {
        "x": 8,
