# Demo configuration — sourced by every script in scripts/.

# Your fork. Argo CD pulls deploy/overlays/* from here; the AI SRE opens PRs here.
GITHUB_REPO=chamodshehanka/self-healing-canaries
REPO_URL=https://github.com/${GITHUB_REPO}.git
# GHCR namespace (lowercase GitHub owner). Images: ghcr.io/<owner>/scn-{payment,inventory,loadgen,ai-sre}
IMAGE_OWNER=chamodshehanka
BASE_TAG=v1.0.0
AI_SRE_IMAGE=ghcr.io/${IMAGE_OWNER}/scn-ai-sre:${BASE_TAG}

# Pinned platform versions
ARGOCD_VERSION=v3.6.1
ARGO_ROLLOUTS_VERSION=v1.10.2
GATEWAYAPI_PLUGIN_VERSION=v0.17.0
ENVOY_GATEWAY_VERSION=v1.9.3

# Demo PR #1 branch (created by scripts/demo/prepare.sh)
PR1_BRANCH=feat/inventory-v2-psp-v2
